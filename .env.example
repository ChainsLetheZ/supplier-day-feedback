# GEMINI_API_KEY: Required for Gemini AI API calls (AI Studio injects this).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted app URL (AI Studio injects this).
APP_URL="MY_APP_URL"

# ---- 扫码场景：腾讯云 CloudBase（国内免费，替代 Firebase）----
# 控制台：https://console.cloud.tencent.com/tcb
# 1. 创建环境 → 复制环境 ID
# 2. 身份认证 → 开启「匿名登录」
# 3. 数据库 → 新建集合 Submission（权限先开所有用户可读写做会场）
# 4. 若有 Publishable Key / accessKey，填到 VITE_TCB_ACCESS_KEY
VITE_TCB_ENV_ID=""
VITE_TCB_REGION="ap-shanghai"
VITE_TCB_ACCESS_KEY=""
